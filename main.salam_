// lang: en
package main

import baremetal
import str

mut cmd := Vector {} as Vector<int>
mut ticks := 0

func _serial_ready(): bool:
    ret (baremetal.In8(0x3FD as u16) & 0x01 as u8) != 0 as u8
end

func _serial_read(): char:
    mut ready := false
    until ready:
        ready = _serial_ready()
    end
    ret baremetal.In8(0x3F8 as u16) as char
end

func _buf_clear():
    cmd = Vector {} as Vector<int>
end

func _buf_push(c: char):
    if cmd.Len() < 64:
        cmd.Push(c as int)
    end
end

func _buf_pop():
    if cmd.Len() > 0:
        cmd.Pop()
    end
end

func _buf_to_str(): str:
    ret str.FromCodePoints(cmd)
end

func _cmd_help():
    println "Commands:"
    println "  help     - show this help"
    println "  clear    - clear screen"
    println "  mem      - show heap usage"
    println "  echo X   - print X"
    println "  ticks    - show tick count"
    println "  halt     - halt CPU"
    println "  exit     - exit QEMU"
end

func _cmd_clear():
 //   baremetal.Clear()
    println "=== SalamOS ==="
end

func _cmd_mem():
    println "heap used: ", baremetal.HeapUsed(), " bytes"
    println "heap size: ", baremetal.HeapSize(), " bytes"
end

func _cmd_echo(arg: str):
    println arg
end

func _cmd_ticks():
    println "ticks: ", ticks
end

func _cmd_halt():
    println "halting..."
    baremetal.Halt()
end

func _cmd_exit():
    println "exiting QEMU"
    baremetal.ExitQemu(0)
end

func _dispatch(cmd_str: str):
    if cmd_str == "help":
        _cmd_help()
    else cmd_str == "clear":
        _cmd_clear()
    else cmd_str == "mem":
        _cmd_mem()
    else cmd_str == "ticks":
        _cmd_ticks()
    else cmd_str == "halt":
        _cmd_halt()
    else cmd_str == "exit":
        _cmd_exit()
    else cmd_str == "reboot":
        _cmd_exit()
    else cmd_str.starts_with("echo "):
        _cmd_echo(cmd_str.substr(5, cmd_str.Len() - 5))
    else cmd_str != "":
        println "unknown command: ", cmd_str
        println "type 'help' for commands"
    end
end

func main:
    baremetal.Clear()
    println "=== SalamOS ==="
    println "a tiny monolithic OS written in Salam"
    println "type 'help' for commands"
    println ""

    until true:
        print "> "
        baremetal.SerialWrite("> ")

        _buf_clear()

        mut done := false
        until done:
            c := _serial_read()
            if c == '\r' or c == '\n':
                done = true
                println ""
            else c == '\b' or c == 127 as char:
                if cmd.Len() > 0:
                    _buf_pop()
                    print "\b \b"
                    baremetal.Out8(0x3F8 as u16, '\b' as u8)
                    baremetal.Out8(0x3F8 as u16, ' ' as u8)
                    baremetal.Out8(0x3F8 as u16, '\b' as u8)
                end
            else c >= ' ':
                _buf_push(c)
                print c
                baremetal.Out8(0x3F8 as u16, c as u8)
            end
            ticks++
        end

        _dispatch(_buf_to_str())
    end
end
